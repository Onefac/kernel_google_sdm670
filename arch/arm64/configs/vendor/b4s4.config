# Google Pixel 3a / 3a XL (b4s4: bonito, sargo), on top of sdm670-perf_defconfig

# Haptics: TI DRV2624 on I2C
CONFIG_INPUT_DRV2624_HAPTICS=y

# Fingerprint: FPC1020 (TEE)
CONFIG_FPC_FINGERPRINT=y

# Touch: Synaptics DSX 2.7 on I2C, which binds synaptics,dsx-i2c like the
# CAF driver, so the latter must be off
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_v27=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_I2C_v27=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE_v27=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV_v27=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE_v27=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_TEST_REPORTING_v27=y

# Security chip (Titan M)
CONFIG_CITADEL=y

# NFC and embedded secure element: NXP PN81A
CONFIG_NFC_NQ=y
CONFIG_NFC_NQ_PN81A=y

# Charging policy
CONFIG_GOOGLE_CHARGER=y

# Type-C and USB-PD: Google's pd_engine on TCPM, not the CAF policy engine
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_LOGBUFFER=y
CONFIG_USB_PD_ENGINE=y
# CONFIG_USB_PD_POLICY is not set

# USB port overheat protection
CONFIG_USB_OVERHEAT_MITIGATION=y
